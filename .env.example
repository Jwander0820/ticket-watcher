# 僅作範例。CLI 從程序環境讀取；Docker Compose 從 .env 注入。
DISCORD_WEBHOOK_URL=
# 設定前先完成 Cloudflare Tunnel + Access；留空維持本機 UI。
TICKET_WATCHER_PUBLIC_ORIGIN=
# 只代理 TicketPlus API；留空維持直連。本機程序可填 http://127.0.0.1:40000。
# VPS 由 scripts/install-vps-warp.sh 設為 http://host.docker.internal:40001。
TICKET_WATCHER_TICKETPLUS_PROXY=
# Docker 連到宿主機的地址；VPS 安裝腳本會填入實際 relay 監聽 IP。
TICKET_WATCHER_WARP_HOST=host-gateway
# 共用 2 核心 / 2 GB VPS 的起始上限，可依實測調整。
TICKET_WATCHER_CPUS=0.50
TICKET_WATCHER_MEMORY=256m
TICKET_WATCHER_PIDS=64
